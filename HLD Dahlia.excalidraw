    {
      "id": "XyzovOd9v8TQb78d8Zowr",
      "type": "text",
      "x": -3532.085123075759,
      "y": 3154.7383914945653,
      "width": 30.7039794921875,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
