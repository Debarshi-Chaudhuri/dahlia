    {
      "id": "t79AR2lPIZ7xQPsMNB2SH",
      "type": "text",
      "x": -5805.094710336855,
      "y": 3720.4240264624277,
      "width": 142.49591064453125,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
