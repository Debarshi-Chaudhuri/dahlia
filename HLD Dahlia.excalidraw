    {
      "id": "uDJVEjpg9qTsoCtXuC5MH",
      "type": "text",
      "x": -5193.016089814492,
      "y": 926.2327203229994,
      "width": 1171.702219580743,
      "height": 2020,
      "angle": 0,
      "strokeColor": "#1e1e1e",
