    {
      "id": "9nD-b_95_dU7pumTwF6DG",
      "type": "text",
      "x": -5766.840419462415,
      "y": 4261.4883457813075,
      "width": 133.40789794921875,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
